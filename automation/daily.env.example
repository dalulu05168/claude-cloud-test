# TEMPLATE ONLY. Copy/edit for the deployment host; replace every replace-* value.
# This is trusted Bash sourced by run-daily.sh. Keep the real daily.env owner-only
# (chmod 600) and editable only by trusted administrators.

WESTCOTT_TIMEZONE=Asia/Shanghai
WESTCOTT_STATE_DIR=/opt/westcott-agent/.westcott-state
WESTCOTT_LOG_DIR=/opt/westcott-agent/.westcott-state/logs
# Protocol identity for the runner adapter. Its model prompt lives in
# prompts/daily-claude-runner.md.
WESTCOTT_ORCHESTRATOR_AGENT=westcott-orchestrator
WESTCOTT_RULESET_VERSION=replace-with-approved-immutable-ruleset-version

# Run on Linux or WSL2 Ubuntu with Bash, jq, flock, Python 3.10+, Node.js,
# and Claude Code 2.1.259+. Make automation/run-claude-code-agent.sh executable.
# The runner uses Claude Code --bare. Inject ANTHROPIC_API_KEY through the
# deployment's secret manager for the scheduled task. Desktop subscription
# sign-in is a separate credential and does not apply to --bare.
WESTCOTT_AGENT_RUNNER=/opt/westcott-agent/automation/run-claude-code-agent.sh
WESTCOTT_CLAUDE_BIN=claude
WESTCOTT_CLAUDE_TIMEOUT_SECONDS=900
WESTCOTT_STOP_GATE_TIMEOUT_SECONDS=30
# Reject stories older than this many hours at validation time (0-720; default 48).
WESTCOTT_MAX_STORY_AGE_HOURS=48

# Copy daily-brief.example.json to this protected deployment path and replace
# every example value before scheduling a run.
WESTCOTT_DAILY_BRIEF_FILE=/opt/westcott-agent/automation/daily-brief.json

# Safe default: create draft.md + research.json for review, but do not publish.
# Live checking uses Tavily Search plus an independent OpenAI Structured Output
# judge. Keep both dedicated keys in this protected file or inject them from the
# host secret manager. Runner passes only these two keys to the validator.
WESTCOTT_AUTO_PUBLISH=false
WESTCOTT_TAVILY_API_KEY=
WESTCOTT_FACT_CHECK_OPENAI_API_KEY=
# For the rootless Docker option, build the image and set this to the wrapper:
# WESTCOTT_FACT_VALIDATOR=/opt/westcott-agent/automation/run-fact-validator-docker.sh
# Direct execution option (less isolated):
# WESTCOTT_FACT_VALIDATOR=/opt/westcott-agent/automation/fact_validator.py
WESTCOTT_FACT_VALIDATOR=

# Publisher accepts --input, --run-id, --date, --title, --folder-id, --manifest;
# stdout must be JSON with run_id, status=saved, document_id, and a Docs URL.
WESTCOTT_DOCS_PUBLISHER=/opt/westcott-agent/automation/sync_google_doc.py
WESTCOTT_GOOGLE_DRIVE_FOLDER_ID=replace-with-authorized-folder-id
WESTCOTT_DOC_TITLE_PREFIX="Westcott Daily Rhythm"

# Optional incoming webhook accepting JSON shaped as {"text":"..."}. Store the
# real URL in a host secret store or protected daily.env; never commit it to Git.
WESTCOTT_ERROR_WEBHOOK_URL=

# Configure ADC/Workload Identity separately for the Google Docs publisher.
