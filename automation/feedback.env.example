# TEMPLATE ONLY. Copy/edit for the deployment host; replace every replace-* value.
# This is trusted Bash sourced by run-weekly-feedback.sh. Protect the real file
# with chmod 600 and allow edits only by trusted administrators.

WESTCOTT_TIMEZONE=Asia/Shanghai
WESTCOTT_STATE_DIR=/opt/westcott-agent/.westcott-state
WESTCOTT_FEEDBACK_JSONL=/opt/westcott-agent/.westcott-state/feedback/inbox/feedback.jsonl

# Point this example path to your executable evaluator adapter. It reads the
# prompt, summary, active rules and test inventory, then prints exactly one
# docs/feedback-proposal.schema.json object to stdout. Give it read-only
# access to the active rules.
WESTCOTT_FEEDBACK_EVALUATOR=/opt/westcott-agent/bin/evaluate-feedback-proposal

# Pin the approved immutable snapshot. The script reads and hashes it but never
# writes it; set the version to the exact version represented by this file.
WESTCOTT_ACTIVE_RULES_FILE=/opt/westcott-agent/rules/active.json
WESTCOTT_ACTIVE_RULES_VERSION=replace-with-current-approved-version
WESTCOTT_FEEDBACK_TEST_INVENTORY=/opt/westcott-agent/docs/feedback-test-inventory.json
WESTCOTT_CANDIDATE_ROOT=/opt/westcott-agent/rules/candidates

# Candidate output is pending human review only; it is not an activation path.
# Install automation/requirements.txt in this Python environment.
WESTCOTT_PYTHON=/opt/westcott-agent/.venv/bin/python

# Rolling window and evidence thresholds. Defaults require 10 feedback samples;
# repeated issues require 3 occurrences across at least 3 distinct run IDs.
WESTCOTT_FEEDBACK_WINDOW_DAYS=28
WESTCOTT_FEEDBACK_MIN_SAMPLES=10
WESTCOTT_FEEDBACK_MIN_ISSUE_COUNT=3
WESTCOTT_FEEDBACK_MIN_DISTINCT_RUNS=3

# The launcher uses orchestration/feedback_eval.py for low-score thresholds.
# Configure any evaluator-specific credentials with the deployment.
